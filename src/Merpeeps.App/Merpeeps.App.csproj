<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Merpie.App</AssemblyName>
    <Version>0.1.0-preview.2</Version>
    <RootNamespace>Merpeeps.App</RootNamespace>
    <Product>Merpie</Product>
    <Title>Merpie</Title>
    <AssemblyTitle>Merpie</AssemblyTitle>
    <Description>Merpie - native visual editor for Mermaid diagrams.</Description>
    <ApplicationIcon>Assets\Brand\merpie-app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Merpeeps.Core\Merpeeps.Core.csproj" />
    <ProjectReference Include="..\Merpeeps.Render\Merpeeps.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Merpeeps.App.Tests" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <AvaloniaResource Include="Assets\Brand\*.png;Assets\Brand\*.ico" />
    <Content Include="Assets\Brand\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\*-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
