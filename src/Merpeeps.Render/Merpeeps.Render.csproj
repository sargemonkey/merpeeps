<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Reference rendering: a self-contained HTML page that draws a diagram with the
    real upstream mermaid.

    Kept apart from Merpeeps.Core deliberately. Core ships to NuGet as a small
    format library, and consumers of the format have no business downloading a
    vendored copy of mermaid with it. Only the editor and the CLI, which actually
    produce previews, take this dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Merpeeps.Render</PackageId>
    <Version>0.2.0-preview.2</Version>
    <Authors>Merpeeps contributors</Authors>
    <Description>Offline Mermaid reference rendering and syntax-validation assets for native hosts.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/sargeMonkey/merpeeps</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Merpeeps.Core\Merpeeps.Core.csproj" />
  </ItemGroup>

  <!-- The shell's import-resolution and escaping helpers are internal because
       nothing outside should call them, but they are exactly the parts worth
       testing directly: both have already produced page-breaking bugs. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Merpeeps.App.Tests" />
  </ItemGroup>

  <!--
    mermaid and js-yaml are vendored verbatim; see Assets/vendor/README.md for
    provenance and licences. The merpeeps-mermaid-layout files are linked straight
    out of packages/ rather than copied, so the preview always exercises the
    exact source we publish instead of a duplicate that could silently drift.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\vendor\mermaid\mermaid.min.js"
                      LogicalName="Merpeeps.Render.Assets.mermaid.min.js" />
    <EmbeddedResource Include="Assets\vendor\mermaid\LICENSE"
                      LogicalName="Merpeeps.Render.Assets.mermaid.LICENSE" />
    <EmbeddedResource Include="Assets\vendor\mermaid\.version"
                      LogicalName="Merpeeps.Render.Assets.mermaid.version" />
    <EmbeddedResource Include="Assets\validation.js"
                      LogicalName="Merpeeps.Render.Assets.validation.js" />
    <EmbeddedResource Include="Assets\zenuml-validation.js"
                      LogicalName="Merpeeps.Render.Assets.zenuml-validation.js" />
    <EmbeddedResource Include="Assets\vendor\zenuml\zenuml.js"
                      LogicalName="Merpeeps.Render.Assets.zenuml.js" />
    <EmbeddedResource Include="Assets\vendor\zenuml\LICENSE"
                      LogicalName="Merpeeps.Render.Assets.zenuml.LICENSE" />
    <EmbeddedResource Include="Assets\vendor\zenuml\THIRD-PARTY-NOTICES.txt"
                      LogicalName="Merpeeps.Render.Assets.zenuml.NOTICES" />
    <EmbeddedResource Include="Assets\vendor\zenuml\.version"
                      LogicalName="Merpeeps.Render.Assets.zenuml.version" />
    <EmbeddedResource Include="Assets\vendor\js-yaml\js-yaml.mjs"
                      LogicalName="Merpeeps.Render.Assets.js-yaml.mjs" />
    <EmbeddedResource Include="Assets\vendor\js-yaml\LICENSE"
                      LogicalName="Merpeeps.Render.Assets.js-yaml.LICENSE" />
    <EmbeddedResource Include="..\..\packages\merpeeps-mermaid-layout\src\index.js"
                      LogicalName="Merpeeps.Render.Assets.merpeeps.index.js" />
    <EmbeddedResource Include="..\..\packages\merpeeps-mermaid-layout\src\mermaid-plugin.js"
                      LogicalName="Merpeeps.Render.Assets.merpeeps.plugin.js" />
    <EmbeddedResource Include="..\..\packages\merpeeps-mermaid-layout\src\rendered-geometry.js"
                      LogicalName="Merpeeps.Render.Assets.rendered-geometry.js" />
  </ItemGroup>
  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
    <None Include="Assets\vendor\mermaid\LICENSE" Pack="true" PackagePath="licenses\mermaid-LICENSE" />
    <None Include="Assets\vendor\js-yaml\LICENSE" Pack="true" PackagePath="licenses\js-yaml-LICENSE" />
    <None Include="Assets\vendor\zenuml\LICENSE" Pack="true" PackagePath="licenses\zenuml-LICENSE" />
    <None Include="Assets\vendor\zenuml\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="licenses\zenuml-THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
